# =============================================================================
# QWEN OS Interactive - Optional environment variables
# =============================================================================
#
# The current app runs without environment variables.
# Copy this file to .env only when you add a real external integration.
#
# Never commit .env.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Reserved API placeholders
# -----------------------------------------------------------------------------
# No production API is required by the current frontend flow.
# If a future feature needs a backend, replace these placeholders with the real
# endpoint and request contract before using them in code.
#
# VITE_QWEN_API_ENDPOINT=YOUR_API_ENDPOINT_HERE
